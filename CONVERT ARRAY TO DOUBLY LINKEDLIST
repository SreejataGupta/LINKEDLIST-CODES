// Definition for a Doubly Linked List node
class Node {
    int data;
    Node next;
    Node prev;

    // Constructor with data only
    Node(int data) {
        this.data = data;
        this.next = null;
        this.prev = null;
    }

    // Constructor with data, next, and prev pointers
    Node(int data, Node next, Node prev) {
        this.data = data;
        this.next = next;
        this.prev = prev;
    }
}

public class DLinkedList {

    // Function to convert an array into a Doubly Linked List[cite: 5]
    public static Node convertArr2DLL(int[] arr) {
        if (arr == null || arr.length == 0) return null;
        
        // Create the head node using the first array element[cite: 5]
        Node head = new Node(arr[0]);
        Node prev = head;
        
        // Loop through the rest of the array to create and link nodes[cite: 5]
        for (int i = 1; i < arr.length; i++) {
            Node temp = new Node(arr[i], null, prev);
            prev.next = temp;
            prev = temp;
        }
        
        return head;
    }

    // Function to traverse and print the Doubly Linked List[cite: 5]
    public static void print(Node head) {
        Node temp = head;
        while (temp != null) {
            System.out.print(temp.data + " ");
            temp = temp.next;
        }
        System.out.println();
    }

    public static void main(String[] args) {
        // Sample array[cite: 5]
        int[] arr = {12, 5, 6, 8};
        
        // Convert array to DLL and print[cite: 5]
        Node head = convertArr2DLL(arr);
        print(head);
    }
}
